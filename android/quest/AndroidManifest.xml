<?xml version="1.0" encoding="utf-8"?>
<!--
    Meta Quest AndroidManifest for OpenXRDS DeviceSDK

    Minimum supported device: Quest 3 / Quest Pro (API 32+). Quest 2 is not supported.

    lib_name must match the [lib] name in apps/xrds-app/Cargo.toml
    when building as a cdylib for Android.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openxrds.devicesdk">

    <uses-sdk
        android:minSdkVersion="32"
        android:targetSdkVersion="35" />

    <!-- Declare as a high-performance VR application.
         Without this feature the Quest shell treats the app as a panel app (sleeping 2D window).
         Required for the compositor to grant immersive VR focus. -->
    <uses-feature android:name="android.hardware.vr.high_performance" android:required="true" />

    <!-- Quest requires 6DoF head tracking -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />

    <!-- Optional XR hardware features — mark required="false" to stay installable on non-XR devices -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />

    <!-- Permissions -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />

    <application
        android:label="@string/app_name"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:debuggable="true">

        <!--
            android.app.lib_name → name of the .so built by Cargo (without "lib" prefix or ".so").
            NativeActivity is built into Android — no extra Java DEX needed.
        -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|density"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape">

            <meta-data
                android:name="android.app.lib_name"
                android:value="xrds_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- com.oculus.intent.category.VR is required for the Quest shell to launch the
                     app in immersive VR mode.  Without it the app is treated as a sleeping panel
                     app (isSleeping=true) and the compositor never grants it a VR surface.
                     Note: .XR is for passthrough/MR apps; .VR is for full VR (both VrApi and OpenXR). -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
